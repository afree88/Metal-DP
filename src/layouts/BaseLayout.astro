---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const configEntry = await getEntry('configuracoes', 'loja');
const loja = configEntry?.data ?? {
  nomeLoja: 'Metal DP',
  slogan: 'Serralheria artística sob medida em Dom Pedro - MA. Solda MMA reforçada e pintura profissional a compressor.',
  telefone: '(99) 9175-6968',
  whatsapp: '559991756968',
  endereco: 'Dom Pedro - MA',
  cidadeBairro: 'Dom Pedro, MA - CEP 65765-000',
  horarioSemana: '07h30 às 18h00',
  horarioDomingo: 'Atendimento e orçamentos online pelo WhatsApp',
  bannerAviso: '⚒️ Metal DP • Serralheria sob medida, solda MMA e pintura no compressor!',
  googleMapsUrl: 'https://maps.app.goo.gl/23J3PhaQqDWC6AuA9',
  chavePix: '559991756968',
  tipoChavePix: 'Celular / WhatsApp',
  titularPix: 'Metal DP Serralheria Artística',
};

const {
  title = `${loja.nomeLoja} - Serralheria Artística Sob Medida | Dom Pedro - MA`,
  description = loja.slogan || 'Serralheria artística especializada em portões, corrimãos, grades ornamentais, móveis industriais e estruturas sob medida em Dom Pedro - MA.',
  image = '/favicon.svg'
} = Astro.props;

const siteUrl = Astro.site?.toString() || 'https://metaldp.netlify.app';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth overflow-x-hidden w-full max-w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Script Inline para evitar Flash no Dark Mode -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- SEO Primário -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteUrl)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, siteUrl)} />

    <!-- Fontes do Google: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 dark:bg-[#080d1a] font-sans text-slate-800 dark:text-slate-100 antialiased transition-colors duration-200 overflow-x-hidden w-full max-w-full relative">
    <!-- Header com navegação e tema dark -->
    <Header loja={loja} />

    <!-- Drawer de Orçamento -->
    <CartDrawer loja={loja} />

    <!-- Conteúdo principal da página -->
    <main class="flex-1 w-full max-w-full overflow-x-hidden">
      <slot />
    </main>

    <!-- Rodapé -->
    <Footer loja={loja} />

    <!-- Botões Flutuantes (WhatsApp e Orçamento Rápido) -->
    <div class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-40 flex flex-col gap-2.5 sm:gap-3 items-end">
      <!-- Botão Flutuante do Orçamento -->
      <button
        id="btn-cart-floating"
        type="button"
        class="relative flex items-center gap-2 rounded-full bg-blue-600 hover:bg-blue-500 text-white font-bold p-3 sm:px-4 sm:py-3 shadow-xl hover:shadow-2xl hover:scale-105 active:scale-95 transition-all focus:outline-none focus:ring-4 focus:ring-blue-300"
        aria-label="Abrir lista de orçamento"
      >
        <svg class="w-5 h-5 sm:w-6 sm:h-6 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
        </svg>
        <span class="hidden sm:inline text-sm">Meu Orçamento</span>
        <span
          id="cart-badge-floating"
          class="hidden absolute -top-1.5 -right-1.5 min-w-[20px] h-[20px] sm:min-w-[22px] sm:h-[22px] px-1 bg-cyan-500 text-slate-950 text-[10px] sm:text-[11px] font-black rounded-full flex items-center justify-center shadow border-2 border-white dark:border-[#080d1a]"
        >
          0
        </span>
      </button>

      <!-- Botão Flutuante do WhatsApp -->
      <a
        href={`https://wa.me/${loja.whatsapp}?text=${encodeURIComponent('Olá! Gostaria de informações e orçamento sobre peças de serralheria da Metal DP.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold p-3 sm:px-3.5 sm:py-2.5 shadow-lg hover:shadow-xl hover:scale-105 transition-all focus:outline-none focus:ring-4 focus:ring-emerald-300"
        aria-label="Fale conosco pelo WhatsApp"
        title="WhatsApp Serralheria"
      >
        <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span class="hidden sm:inline text-xs">WhatsApp</span>
      </a>
    </div>

    <!-- Script de Inicialização dos Botões Flutuantes e Drawer -->
    <script>
      // Sincroniza o badge do botão flutuante com a contagem do carrinho
      function updateFloatingBadge() {
        const badge = document.getElementById('cart-badge-floating');
        if (!badge) return;
        
        try {
          const raw = localStorage.getItem('bompreco_cart_v1');
          const itens = raw ? JSON.parse(raw) : [];
          const totalQtd = itens.reduce((acc, item) => acc + (item.quantidade || 1), 0);
          
          if (totalQtd > 0) {
            badge.textContent = totalQtd > 99 ? '99+' : String(totalQtd);
            badge.classList.remove('hidden');
            badge.classList.add('flex');
          } else {
            badge.classList.add('hidden');
            badge.classList.remove('flex');
          }
        } catch (e) {
          badge.classList.add('hidden');
        }
      }

      // Abre o carrinho ao clicar no botão flutuante
      document.getElementById('btn-cart-floating')?.addEventListener('click', () => {
        if (window.carrinhoMercado) {
          window.carrinhoMercado.abrir();
        }
      });

      // Atualiza badge no carregamento e ao mudar carrinho
      updateFloatingBadge();
      window.addEventListener('storage', updateFloatingBadge);
      window.addEventListener('cart:updated', updateFloatingBadge);
    </script>
  </body>
</html>
