---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const produtos = await getCollection('produtos');
  return produtos.map((prod) => ({
    params: { slug: prod.slug },
    props: { produto: prod },
  }));
}

const { produto } = Astro.props;
const { Content } = await produto.render();

// Busca dados da loja
const configEntry = await getEntry('configuracoes', 'loja');
const loja = configEntry?.data ?? {
  nomeLoja: 'Metal DP',
  whatsapp: '559991756968',
  telefone: '(99) 9175-6968',
  chavePix: '559991756968',
  tipoChavePix: 'Celular / WhatsApp',
  titularPix: 'Metal DP Serralheria Artística',
};

// Formatação brasileira de moeda
const formatCurrency = (val: number) => {
  return val.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
};

const temPromocao = produto.data.precoPromocional && produto.data.precoPromocional < produto.data.preco;
const precoFinal = temPromocao ? produto.data.precoPromocional! : produto.data.preco;
const percentualDesconto = temPromocao
  ? Math.round(((produto.data.preco - produto.data.precoPromocional!) / produto.data.preco) * 100)
  : 0;

// Mensagem para o WhatsApp
const mensagemWhatsApp = `Olá! Vi a peça *${produto.data.nome}* no catálogo da Metal DP (${formatCurrency(precoFinal)} / ${produto.data.unidade}) e gostaria de tirar dúvidas e solicitar orçamento sob medida!`;

// Busca produtos relacionados da mesma categoria
const todosProdutos = await getCollection('produtos');
const produtosRelacionados = todosProdutos
  .filter((p) => p.data.categoria === produto.data.categoria && p.slug !== produto.slug)
  .slice(0, 4);
---

<BaseLayout
  title={`${produto.data.nome} - ${loja.nomeLoja}`}
  description={produto.data.descricao}
  image={produto.data.imagem}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <!-- Breadcrumb de Navegação -->
    <nav class="flex items-center text-xs text-slate-500 dark:text-slate-400 mb-6 gap-2">
      <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400">Início</a>
      <span>&bull;</span>
      <a href="/produtos" class="hover:text-blue-600 dark:hover:text-blue-400">Galeria de Peças</a>
      <span>&bull;</span>
      <a
        href={`/produtos?categoria=${encodeURIComponent(produto.data.categoria)}`}
        class="hover:text-blue-600 dark:hover:text-blue-400 font-medium text-slate-700 dark:text-slate-300"
      >
        {produto.data.categoria}
      </a>
      <span>&bull;</span>
      <span class="text-slate-900 dark:text-white font-semibold truncate">{produto.data.nome}</span>
    </nav>

    <!-- Card Principal do Produto -->
    <div class="bg-white dark:bg-[#0c1527] rounded-3xl border border-slate-200/90 dark:border-blue-950/80 shadow-card p-6 sm:p-10 mb-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-start">
        
        <!-- Foto Ampliada da Peça com Moldura Metálica -->
        <div class="relative rounded-2xl overflow-hidden bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-blue-900 shadow-lg aspect-square max-h-[500px] w-full">
          <img
            src={produto.data.imagem}
            alt={produto.data.nome}
            class="w-full h-full object-cover object-center"
          />
          
          <!-- Badges de Status -->
          <div class="absolute top-4 left-4 flex flex-col gap-2">
            {temPromocao && produto.data.disponivel && (
              <span class="bg-gradient-to-r from-blue-600 to-cyan-600 text-white font-black text-xs px-3 py-1.5 rounded-full shadow-lg uppercase tracking-wider">
                {percentualDesconto}% DE DESCONTO
              </span>
            )}
            {produto.data.destaque && (
              <span class="bg-blue-600 text-white font-bold text-xs px-3 py-1 rounded-full shadow">
                Obra em Destaque
              </span>
            )}
          </div>

          {!produto.data.disponivel && (
            <div class="absolute inset-0 bg-slate-950/70 backdrop-blur-[2px] flex items-center justify-center">
              <span class="bg-white text-slate-900 font-black text-sm px-4 py-2 rounded-xl uppercase tracking-widest shadow-xl">
                Produção Sob Encomenda
              </span>
            </div>
          )}
        </div>

        <!-- Informações e Ações da Peça -->
        <div class="flex flex-col justify-between h-full">
          <div>
            <!-- Categoria e Disponibilidade -->
            <div class="flex items-center justify-between gap-2 mb-3">
              <a
                href={`/produtos?categoria=${encodeURIComponent(produto.data.categoria)}`}
                class="text-xs uppercase tracking-wider font-bold text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/60 px-3 py-1 rounded-full border border-blue-200/50 dark:border-blue-800/60"
              >
                {produto.data.categoria}
              </a>

              {produto.data.disponivel ? (
                <span class="flex items-center gap-1.5 text-xs font-semibold text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-2.5 py-1 rounded-full">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  Fabricação & Pronta Entrega
                </span>
              ) : (
                <span class="text-xs font-semibold text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/60 px-2.5 py-1 rounded-full">
                  Sob Medida
                </span>
              )}
            </div>

            <!-- Título do Produto -->
            <h1 class="text-2xl sm:text-4xl font-black text-slate-900 dark:text-white leading-tight">
              {produto.data.nome}
            </h1>

            <!-- Preço de Referência em Destaque -->
            <div class="mt-6 p-5 rounded-2xl bg-slate-50 dark:bg-slate-900/80 border border-slate-200/80 dark:border-blue-950">
              <div class="flex items-baseline gap-3">
                {temPromocao ? (
                  <div>
                    <span class="text-sm text-slate-400 dark:text-slate-500 line-through block">
                      De {formatCurrency(produto.data.preco)}
                    </span>
                    <div class="flex items-baseline gap-1.5">
                      <span class="text-3xl sm:text-4xl font-black text-blue-600 dark:text-blue-400">
                        {formatCurrency(produto.data.precoPromocional!)}
                      </span>
                      <span class="text-sm font-semibold text-slate-600 dark:text-slate-400">
                        / {produto.data.unidade}
                      </span>
                    </div>
                    <span class="inline-block mt-1 text-xs font-bold text-emerald-700 dark:text-emerald-400">
                      Condição especial: economia de {formatCurrency(produto.data.preco - produto.data.precoPromocional!)}!
                    </span>
                  </div>
                ) : (
                  <div class="flex items-baseline gap-1.5">
                    <span class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">
                      {formatCurrency(produto.data.preco)}
                    </span>
                    <span class="text-sm font-semibold text-slate-600 dark:text-slate-400">
                      / {produto.data.unidade}
                    </span>
                  </div>
                )}
              </div>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-2">
                * Valores sob medida ajustados conforme vão, tipo de aço e acabamento escolhido.
              </p>
            </div>

            <!-- Descrição Curta -->
            <div class="mt-6">
              <h3 class="text-xs uppercase font-bold text-slate-500 dark:text-slate-400 tracking-wider mb-2">Sobre esta obra artesanal</h3>
              <p class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed">
                {produto.data.descricao}
              </p>
            </div>

            <!-- Conteúdo detalhado do Markdown -->
            <div class="mt-5 prose prose-sm dark:prose-invert text-slate-600 dark:text-slate-400 border-t border-slate-100 dark:border-blue-950 pt-4">
              <Content />
            </div>
          </div>

          <!-- Ação de Orçamento / WhatsApp -->
          <div class="mt-8 pt-6 border-t border-slate-100 dark:border-blue-950 flex flex-col gap-3">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <!-- Botão Incluir na Lista de Orçamento -->
              <button
                id="btn-detalhes-add-cart"
                type="button"
                class="w-full inline-flex items-center justify-center gap-2.5 bg-blue-600 hover:bg-blue-500 text-white font-black text-sm sm:text-base px-6 py-4 rounded-2xl shadow-lg shadow-blue-600/25 transition-all hover:scale-[1.01]"
                data-slug={produto.slug}
                data-nome={produto.data.nome}
                data-preco={precoFinal}
                data-unidade={produto.data.unidade}
                data-imagem={produto.data.imagem}
              >
                <svg class="w-5 h-5 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                <span id="detalhes-btn-text">Incluir no Orçamento</span>
              </button>

              <!-- Botão Pedir Direto no WhatsApp -->
              <a
                href={`https://wa.me/${loja.whatsapp}?text=${encodeURIComponent(mensagemWhatsApp)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm sm:text-base px-6 py-4 rounded-2xl shadow-md transition-all hover:scale-[1.01]"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                <span>Orçar no WhatsApp</span>
              </a>
            </div>

            <a
              href="/produtos"
              class="w-full text-center py-2.5 text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition"
            >
              &larr; Voltar para a Galeria Completa
            </a>
          </div>

          <!-- Informações de acabamento e segurança -->
          <div class="mt-4 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
            <svg class="w-4 h-4 text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            <span>Tratamento antiferrugem profissional e garantia estrutural de fábrica.</span>
          </div>

        </div>

      </div>
    </div>

    <!-- Seção de Peças Relacionadas -->
    {produtosRelacionados.length > 0 && (
      <section class="mt-14">
        <h2 class="text-2xl font-black text-slate-900 dark:text-white mb-6">
          Outras obras em {produto.data.categoria}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
          {produtosRelacionados.map((rel) => (
            <ProductCard
              slug={rel.slug}
              nome={rel.data.nome}
              preco={rel.data.preco}
              precoPromocional={rel.data.precoPromocional}
              unidade={rel.data.unidade}
              categoria={rel.data.categoria}
              descricao={rel.data.descricao}
              imagem={rel.data.imagem}
              disponivel={rel.data.disponivel}
              destaque={rel.data.destaque}
              whatsapp={loja.whatsapp}
            />
          ))}
        </div>
      </section>
    )}

  </div>
</BaseLayout>

<script>
  const btnAddCart = document.getElementById('btn-detalhes-add-cart');
  const btnText = document.getElementById('detalhes-btn-text');

  btnAddCart?.addEventListener('click', (e) => {
    const target = e.currentTarget as HTMLButtonElement;
    const slug = target.getAttribute('data-slug') || '';
    const nome = target.getAttribute('data-nome') || '';
    const preco = parseFloat(target.getAttribute('data-preco') || '0');
    const unidade = target.getAttribute('data-unidade') || 'peça';
    const imagem = target.getAttribute('data-imagem') || '';

    if ((window as any).carrinhoMercado) {
      (window as any).carrinhoMercado.adicionar({
        slug,
        nome,
        preco,
        unidade,
        imagem,
      });

      if (btnText) {
        btnText.textContent = 'Incluído na Lista! ✓';
        setTimeout(() => {
          btnText.textContent = 'Incluir no Orçamento';
        }, 2000);
      }
    }
  });
</script>
