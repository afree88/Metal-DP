---
import BaseLayout from '../layouts/BaseLayout.astro';
import NetlifyForm from '../components/NetlifyForm.astro';
import { getEntry } from 'astro:content';

const configEntry = await getEntry('configuracoes', 'loja');
const loja = configEntry?.data ?? {
  nomeLoja: 'Metal DP',
  telefone: '(99) 9175-6968',
  whatsapp: '559991756968',
  endereco: 'Dom Pedro - MA',
  cidadeBairro: 'Dom Pedro, MA - CEP 65765-000',
  horarioSemana: 'Segunda a Sexta: 07h30 às 18h00 | Sábado: 08h00 às 12h00',
  horarioDomingo: 'Atendimento e orçamentos online pelo WhatsApp',
};

const enviadoComSucesso = Astro.url.searchParams.get('sucesso') === 'true';

const faqs = [
  {
    pergunta: 'Vocês fazem projetos 100% sob medida a partir de fotos de referência?',
    resposta: 'Sim! Se você viu um portão, corrimão, grade ou móvel na internet, Pinterest ou no projeto de um arquiteto, fabricamos a peça sob medida com solda MMA reforçada e dimensões perfeitas para o seu espaço.'
  },
  {
    pergunta: 'Como funciona a proteção antiferrugem e acabamento das peças?',
    resposta: 'Nossas peças passam por limpeza minuciosa, desbaste de solda, aplicação de fundo primer antiferrugem anticorrosivo e pintura no compressor profissional com tinta de alta qualidade. Esse acabamento de padrão automotivo protege o aço contra chuva, sol forte e umidade, garantindo longa durabilidade.'
  },
  {
    pergunta: 'Vocês realizam instalação no local?',
    resposta: 'Sim! Entregamos e instalamos com fixação firme e prumo rigoroso em residências, comércios e chácaras em Dom Pedro e região do Maranhão.'
  },
  {
    pergunta: 'Quais as formas de pagamento aceitas para encomendas?',
    resposta: 'Trabalhamos com entrada/sinal de 50% para compra de materiais e início da confecção, e o saldo restante na entrega/instalação. Aceitamos PIX, Dinheiro em espécie e Bitcoin instantâneo via Lightning Network (BTC). No momento não aceitamos cartão.'
  }
];
---

<BaseLayout
  title={`Contato e Orçamentos - ${loja.nomeLoja} | Serralheria Artística`}
  description="Entre em contato com a Metal DP. Solicite orçamentos para portões, corrimãos, grades e móveis de ferro ou fale direto pelo WhatsApp oficial."
>
  <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 py-8 sm:py-16 overflow-hidden">
    
    <!-- Notificação de Sucesso do Envio -->
    {enviadoComSucesso && (
      <div class="mb-6 sm:mb-8 p-3.5 sm:p-4 rounded-2xl bg-blue-50 dark:bg-blue-950/70 border border-blue-200 dark:border-blue-800 text-blue-900 dark:text-blue-200 flex items-center gap-3 shadow-sm">
        <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-xs sm:text-sm shrink-0">
          ✓
        </div>
        <div>
          <h4 class="font-bold text-xs sm:text-sm">Solicitação enviada com sucesso!</h4>
          <p class="text-[11px] sm:text-xs text-blue-700 dark:text-blue-300">Agradecemos o seu contato. A equipe da Metal DP responderá com sua estimativa de orçamento o mais breve possível.</p>
        </div>
      </div>
    )}

    <!-- Cabeçalho -->
    <div class="max-w-2xl mb-8 sm:mb-12">
      <span class="text-[11px] sm:text-xs uppercase font-extrabold tracking-wider text-blue-700 dark:text-blue-300 bg-blue-100 dark:bg-blue-950/70 border border-blue-300 dark:border-blue-800 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full inline-block mb-3">
        Canais de Atendimento & Orçamentos
      </span>
      <h1 class="text-2xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Dê Vida ao seu Projeto em Ferro e Aço
      </h1>
      <p class="mt-2 sm:mt-3 text-slate-600 dark:text-slate-400 text-xs sm:text-base">
        Fale diretamente com nossa oficina por mensagem ou pelo WhatsApp oficial para atendimento rápido.
      </p>
    </div>

    <!-- Grid: Formulário WhatsApp + Cartões de Contato -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-10 items-start mb-12 sm:mb-16">
      
      <!-- Lado Esquerdo: Formulário com Envio Direto via WhatsApp (7 colunas) -->
      <div class="lg:col-span-7">
        <NetlifyForm whatsapp={loja.whatsapp} />
      </div>

      <!-- Lado Direito: Informações Rápidas (5 colunas) -->
      <div class="lg:col-span-5 space-y-4 sm:space-y-6">
        
        <!-- Cartão WhatsApp Direto -->
        <div class="bg-gradient-to-br from-blue-700 via-blue-800 to-slate-900 text-white p-5 sm:p-8 rounded-2xl sm:rounded-3xl shadow-xl border border-blue-500/30">
          <div class="flex items-center gap-3 mb-3 sm:mb-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-white/10 flex items-center justify-center text-white border border-white/20 shrink-0">
              <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current text-cyan-300" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            </div>
            <div>
              <h3 class="font-bold text-base sm:text-lg">Orçamento Imediato no WhatsApp</h3>
              <p class="text-[11px] sm:text-xs text-blue-200">Envie fotos de referência e medidas</p>
            </div>
          </div>
          <p class="text-xs text-blue-100 mb-4 sm:mb-5 leading-relaxed">
            Prefere conversar agora? Mande mensagem e fale diretamente conosco:
          </p>
          <a
            href={`https://wa.me/${loja.whatsapp}?text=${encodeURIComponent('Olá! Gostaria de um orçamento para peças de serralheria artística da Metal DP.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 w-full px-4 py-3 rounded-xl sm:rounded-2xl bg-white text-blue-800 font-black text-xs sm:text-sm hover:bg-blue-50 shadow transition text-center"
          >
            <span>Conversar no WhatsApp ({loja.telefone})</span>
          </a>
        </div>

        <!-- Cartão Oficina & Horários -->
        <div class="bg-white dark:bg-[#0c1527] p-5 sm:p-8 rounded-2xl sm:rounded-3xl border border-slate-200/90 dark:border-blue-950/80 shadow-card space-y-3 sm:space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center text-lg sm:text-xl shrink-0">
              📍
            </div>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white text-xs sm:text-sm">Oficina & Serralheria</h4>
              <p class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400">{loja.endereco} &bull; {loja.cidadeBairro}</p>
            </div>
          </div>

          <div class="pt-3 border-t border-slate-100 dark:border-slate-800 space-y-1.5 sm:space-y-2 text-xs text-slate-600 dark:text-slate-400">
            <div class="flex items-center justify-between">
              <span>Segunda a Sexta:</span>
              <strong class="text-slate-900 dark:text-white">{loja.horarioSemana}</strong>
            </div>
            <div class="flex items-center justify-between">
              <span>Sábados:</span>
              <strong class="text-slate-900 dark:text-white">08h00 às 12h00</strong>
            </div>
            <div class="flex items-center justify-between">
              <span>Domingos:</span>
              <strong class="text-blue-600 dark:text-blue-400">Plantão WhatsApp</strong>
            </div>
          </div>

          <div class="pt-2">
            <a
              href="/localizacao"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline"
            >
              <span>Ver mapa e rota de acesso &rarr;</span>
            </a>
          </div>
        </div>

      </div>

    </div>

    <!-- Seção de Perguntas Frequentes (FAQ) -->
    <div class="mt-10 sm:mt-16 max-w-4xl mx-auto">
      <div class="text-center mb-6 sm:mb-10">
        <span class="text-[11px] sm:text-xs uppercase font-extrabold tracking-wider text-blue-700 dark:text-blue-300 bg-blue-100 dark:bg-blue-950/70 border border-blue-300 dark:border-blue-800 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full inline-block mb-2 sm:mb-3">
          Tire Suas Dúvidas
        </span>
        <h2 class="text-xl sm:text-3xl font-black text-slate-900 dark:text-white">Perguntas Frequentes sobre Encomendas</h2>
      </div>

      <div class="space-y-3 sm:space-y-4">
        {faqs.map((faq) => (
          <div class="p-4 sm:p-6 rounded-xl sm:rounded-2xl bg-white dark:bg-[#0c1527] border border-slate-200/90 dark:border-blue-950/80 shadow-sm">
            <h3 class="font-bold text-xs sm:text-base text-slate-900 dark:text-white mb-1.5 sm:mb-2 flex items-center gap-2">
              <span class="text-blue-500 shrink-0">❖</span>
              <span>{faq.pergunta}</span>
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed pl-4 sm:pl-5">
              {faq.resposta}
            </p>
          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>
