---
interface Props {
  slug: string;
  nome: string;
  preco: number;
  precoPromocional?: number | null;
  unidade: string;
  categoria: string;
  descricao: string;
  imagem: string;
  disponivel: boolean;
  destaque?: boolean;
  whatsapp?: string;
}

const {
  slug,
  nome,
  preco,
  precoPromocional,
  unidade = 'peça',
  categoria,
  descricao,
  imagem,
  disponivel = true,
  destaque = false,
  whatsapp = '559991756968',
} = Astro.props;

// Formatação brasileira de moeda
const formatCurrency = (val: number) => {
  return val.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
};

// Cálculo de percentual de desconto se houver promoção
const temPromocao = precoPromocional && precoPromocional < preco;
const percentualDesconto = temPromocao
  ? Math.round(((preco - precoPromocional) / preco) * 100)
  : 0;

const precoFinal = temPromocao ? precoPromocional : preco;
---

<div class={`group relative flex flex-col metallic-card bg-white dark:bg-[#0c1527] rounded-2xl border border-slate-200/90 dark:border-blue-950/80 shadow-card hover:shadow-card-hover hover:border-blue-500/50 dark:hover:border-blue-500/50 transition-all duration-300 overflow-hidden ${!disponivel ? 'opacity-70 grayscale-[30%]' : ''}`}>
  
  <!-- Badges Flutuantes -->
  <div class="absolute top-3 left-3 z-10 flex flex-col gap-1.5 items-start">
    {temPromocao && disponivel && (
      <span class="inline-flex items-center gap-1 bg-gradient-to-r from-blue-600 to-cyan-600 text-white text-[11px] font-extrabold px-2.5 py-1 rounded-full shadow-md tracking-wider uppercase">
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.316.492-.633 1.09-1.026 1.838-.727 1.385-1.745 3.32-3.177 5.642C4.375 13.064 3 15.65 3 17a4 4 0 008 0c0-.853-.298-1.636-.8-2.26a1 1 0 01.378-1.558c.995-.49 1.954-1.22 2.76-2.128.825-.928 1.488-2.036 1.914-3.238.163-.46.305-.924.423-1.39A8.995 8.995 0 0016 7a1 1 0 00-1-1c-.88 0-1.704.28-2.605.553z" clip-rule="evenodd"></path></svg>
        {percentualDesconto}% OFF
      </span>
    )}
    {destaque && disponivel && !temPromocao && (
      <span class="bg-blue-600 text-white text-[11px] font-bold px-2.5 py-0.5 rounded-full shadow-sm">
        Obra em Destaque
      </span>
    )}
    {!disponivel && (
      <span class="bg-slate-700 text-white text-[11px] font-bold px-2.5 py-1 rounded-full shadow-sm uppercase tracking-wide">
        Sob Encomenda
      </span>
    )}
  </div>

  <!-- Foto do Produto com Zoom Suave -->
  <a href={`/produtos/${slug}`} class="relative block h-44 sm:h-56 w-full overflow-hidden bg-slate-100 dark:bg-slate-900/80 focus:outline-none">
    <img
      src={imagem}
      alt={nome}
      loading="lazy"
      class="h-full w-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
    <div class="absolute bottom-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity">
      <span class="bg-slate-950/90 text-cyan-300 text-[10px] font-bold px-2 py-1 rounded-md border border-blue-500/30">
        Ver Detalhes
      </span>
    </div>
  </a>

  <!-- Informações do Produto -->
  <div class="p-3.5 sm:p-5 flex-1 flex flex-col justify-between">
    <div>
      <!-- Categoria com link para filtro -->
      <a
        href={`/produtos?categoria=${encodeURIComponent(categoria)}`}
        class="inline-block text-[10px] sm:text-[11px] uppercase tracking-wider font-bold text-blue-700 dark:text-blue-300 hover:text-blue-800 bg-blue-50 dark:bg-blue-950/60 border border-blue-200/50 dark:border-blue-800/60 px-2 py-0.5 rounded-md mb-1.5 sm:mb-2 truncate max-w-full"
      >
        {categoria}
      </a>

      <!-- Nome da Peça -->
      <h3 class="font-bold text-slate-900 dark:text-white text-xs sm:text-base leading-snug line-clamp-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
        <a href={`/produtos/${slug}`}>
          {nome}
        </a>
      </h3>

      <!-- Descrição Curta -->
      <p class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 line-clamp-2 mt-1 sm:mt-1.5 leading-relaxed hidden min-[360px]:block">
        {descricao}
      </p>
    </div>

    <!-- Seção de Preços e Ações -->
    <div class="mt-3 sm:mt-4 pt-2.5 sm:pt-3 border-t border-slate-100 dark:border-blue-950">
      <div class="flex items-baseline gap-1 sm:gap-2">
        {temPromocao ? (
          <div class="flex flex-col">
            <span class="text-[10px] sm:text-xs text-slate-400 dark:text-slate-500 line-through">
              {formatCurrency(preco)}
            </span>
            <div class="flex items-baseline gap-0.5 sm:gap-1">
              <span class="text-base sm:text-xl font-black text-blue-600 dark:text-blue-400">
                {formatCurrency(precoPromocional!)}
              </span>
              <span class="text-[10px] sm:text-xs font-semibold text-slate-500 dark:text-slate-400">
                /{unidade}
              </span>
            </div>
          </div>
        ) : (
          <div class="flex items-baseline gap-0.5 sm:gap-1">
            <span class="text-base sm:text-xl font-black text-slate-900 dark:text-white">
              {formatCurrency(preco)}
            </span>
            <span class="text-[10px] sm:text-xs font-semibold text-slate-500 dark:text-slate-400">
              /{unidade}
            </span>
          </div>
        )}
      </div>

      <!-- Botões de Ação do Card -->
      <div class="mt-3 flex flex-col gap-1.5">
        <!-- Botão Adicionar à Lista de Orçamento -->
        {disponivel ? (
          <button
            type="button"
            class="btn-add-carrinho w-full flex items-center justify-center gap-1.5 sm:gap-2 text-[11px] sm:text-xs font-bold text-white bg-blue-600 hover:bg-blue-500 active:scale-95 px-2.5 sm:px-3 py-2 sm:py-2.5 rounded-xl shadow-md shadow-blue-600/20 hover:shadow-lg transition-all"
            data-slug={slug}
            data-nome={nome}
            data-preco={precoFinal}
            data-unidade={unidade}
            data-imagem={imagem}
          >
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-none stroke-current shrink-0" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            <span class="btn-text">Incluir no Orçamento</span>
          </button>
        ) : (
          <a
            href={`https://wa.me/${whatsapp}?text=${encodeURIComponent(`Olá! Gostaria de encomendar a peça *${nome}* sob medida.`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center text-[11px] sm:text-xs font-bold text-blue-900 dark:text-blue-200 bg-blue-100 dark:bg-blue-950/60 py-2 sm:py-2.5 rounded-xl hover:bg-blue-200 transition"
          >
            Encomendar Sob Medida
          </a>
        )}

        <!-- Link secundário de detalhes -->
        <a
          href={`/produtos/${slug}`}
          class="flex items-center justify-center text-[10px] sm:text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-slate-100 dark:hover:bg-slate-800 py-1 sm:py-1.5 rounded-lg transition text-center"
        >
          <span>Especificações & Fotos &rarr;</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  function handleAddToCart(btn: HTMLButtonElement) {
    const slug = btn.getAttribute('data-slug') || '';
    const nome = btn.getAttribute('data-nome') || '';
    const preco = parseFloat(btn.getAttribute('data-preco') || '0');
    const unidade = btn.getAttribute('data-unidade') || 'peça';
    const imagem = btn.getAttribute('data-imagem') || '';

    if ((window as any).carrinhoMercado) {
      (window as any).carrinhoMercado.adicionar({
        slug,
        nome,
        preco,
        unidade,
        imagem,
      });

      const textSpan = btn.querySelector('.btn-text');
      if (textSpan) {
        const originalText = textSpan.textContent;
        textSpan.textContent = 'Incluído! ✓';
        btn.classList.remove('bg-blue-600', 'hover:bg-blue-500');
        btn.classList.add('bg-emerald-600', 'text-white');
        setTimeout(() => {
          if (textSpan) textSpan.textContent = originalText;
          btn.classList.add('bg-blue-600', 'hover:bg-blue-500');
          btn.classList.remove('bg-emerald-600', 'text-white');
        }, 1500);
      }
    } else {
      setTimeout(() => handleAddToCart(btn), 300);
    }
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('.btn-add-carrinho') as HTMLButtonElement | null;
    if (btn) {
      e.preventDefault();
      handleAddToCart(btn);
    }
  });
</script>
