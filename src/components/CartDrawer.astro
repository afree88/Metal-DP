---
interface Props {
  loja: {
    nomeLoja: string;
    whatsapp: string;
    chavePix: string;
    tipoChavePix: string;
    titularPix: string;
    aceitaPix?: boolean;
    aceitaDinheiro?: boolean;
    obsDinheiro?: string;
    aceitaCartao?: boolean;
    obsCartao?: string;
    aceitaBitcoinLightning?: boolean;
    enderecoLightning?: string;
    obsBitcoinLightning?: string;
  };
}

const { loja } = Astro.props;
const aceitaPix = loja.aceitaPix !== false;
const aceitaDinheiro = loja.aceitaDinheiro !== false;
const aceitaCartao = loja.aceitaCartao === true;
const aceitaLightning = loja.aceitaBitcoinLightning === true;
const enderecoLightning = loja.enderecoLightning || 'talison@walletofsatoshi.com';
---

<!-- Drawer do Orçamento -->
<div
  id="cart-drawer-container"
  class="fixed inset-0 z-50 pointer-events-none transition-opacity duration-300 opacity-0"
>
  <!-- Backdrop Escurecido -->
  <div
    id="cart-backdrop"
    class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm transition-opacity"
  ></div>

  <!-- Painel Lateral -->
  <div class="fixed inset-y-0 right-0 w-full sm:max-w-full sm:flex sm:pl-10">
    <div
      id="cart-panel"
      class="w-full h-full sm:max-w-md bg-white dark:bg-[#0c1527] border-l border-slate-200 dark:border-blue-950 shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300 pointer-events-auto ml-auto overflow-hidden"
    >
      <!-- Topo do Carrinho / Orçamento -->
      <div class="px-6 py-5 border-b border-slate-200 dark:border-blue-950 flex items-center justify-between bg-slate-50 dark:bg-[#080d1a]">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-800 flex items-center justify-center text-white shadow-sm">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M19 7h-1V5a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2H5a3 3 0 0 0-3 3v2a1 1 0 0 0 1 1h1.1a5.98 5.98 0 0 0 4.9 2.9V18H7a1 1 0 0 0-1 1v1h12v-1a1 1 0 0 0-1-1h-2v-2.1a5.98 5.98 0 0 0 4.9-2.9H21a1 1 0 0 0 1-1v-2a3 3 0 0 0-3-3z"/>
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-black text-slate-900 dark:text-white">Lista de Orçamento</h2>
            <span id="cart-items-count-header" class="text-xs text-slate-500 dark:text-slate-400">0 peças selecionadas</span>
          </div>
        </div>

        <button
          id="cart-close-btn"
          type="button"
          class="p-2 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-white hover:bg-slate-200/60 dark:hover:bg-slate-800 transition"
          aria-label="Fechar orçamento"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <!-- Lista de Itens do Orçamento -->
      <div id="cart-items-list" class="flex-[2] min-h-0 overflow-y-auto overscroll-contain p-4 sm:p-6 space-y-3">
        <!-- Renderizado dinamicamente pelo JavaScript -->
      </div>

      <!-- Estado Vazio -->
      <div id="cart-empty-state" class="hidden flex-1 min-h-0 flex flex-col items-center justify-center p-8 text-center overflow-y-auto">
        <div class="w-20 h-20 rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center text-4xl mb-4 border border-blue-200 dark:border-blue-900">
          ⚒️
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Sua lista está vazia</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-xs mb-6">
          Adicione portões, corrimãos, pergolados ou móveis da galeria para calcular e enviar seu orçamento.
        </p>
        <button
          id="cart-empty-explore-btn"
          class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs shadow-md transition"
        >
          Explorar Peças da Oficina
        </button>
      </div>

      <!-- Rodapé com Totais e Botões de Checkout (WhatsApp, PIX, BTC Lightning) -->
      <div id="cart-footer" class="shrink-0 p-4 sm:p-6 border-t border-slate-200 dark:border-blue-950 bg-slate-50 dark:bg-[#080d1a] space-y-3">
        
        <!-- Opção de Entrega ou Instalação -->
        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-slate-700 dark:text-slate-300">Entrega / Instalação:</span>
            <div class="flex gap-3">
              <label class="inline-flex items-center gap-1 cursor-pointer">
                <input type="radio" name="tipo-entrega" value="instalacao" checked class="text-blue-600 focus:ring-blue-500" />
                <span class="text-slate-700 dark:text-slate-300 font-medium">Entrega</span>
              </label>
              <label class="inline-flex items-center gap-1 cursor-pointer">
                <input type="radio" name="tipo-entrega" value="retirada" class="text-blue-600 focus:ring-blue-500" />
                <span class="text-slate-700 dark:text-slate-300 font-medium">Retirar na Serralheria</span>
              </label>
            </div>
          </div>

          <div id="campo-endereco-container">
            <input
              type="text"
              id="cart-cliente-endereco"
              placeholder="Cidade, bairro ou endereço da obra..."
              class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
        </div>

        <!-- Resumo Estimado -->
        <div class="space-y-1.5 pt-2 border-t border-slate-200 dark:border-blue-950 text-sm">
          <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 text-xs">
            <span>Estimativa Inicial</span>
            <span id="cart-subtotal" class="font-semibold text-slate-700 dark:text-slate-300">R$ 0,00</span>
          </div>
          <div class="flex items-center justify-between text-base font-extrabold text-slate-900 dark:text-white pt-1">
            <span>Valor Estimado</span>
            <span id="cart-total" class="text-xl text-blue-600 dark:text-blue-400 font-black">R$ 0,00</span>
          </div>
          <p class="text-[10px] text-slate-400 dark:text-slate-500">
            * Valores sob medida finais confirmados no atendimento técnico.
          </p>
        </div>

        <!-- Meios de Pagamento Disponíveis -->
        <div class="pt-1">
          <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1.5">
            Pagamentos aceitos:
          </span>
          <div class="flex flex-wrap items-center gap-1.5">
            {aceitaPix && (
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-blue-100 dark:bg-blue-950/70 border border-blue-300 dark:border-blue-800 text-[11px] font-bold text-blue-700 dark:text-blue-300">
                <span>💠</span> PIX
              </span>
            )}
            {aceitaDinheiro && (
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-emerald-100 dark:bg-emerald-950/70 border border-emerald-300 dark:border-emerald-800 text-[11px] font-bold text-emerald-700 dark:text-emerald-300">
                <span>💵</span> Dinheiro
              </span>
            )}
            {aceitaLightning && (
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-amber-100 dark:bg-amber-950/70 border border-amber-300 dark:border-amber-800 text-[11px] font-bold text-amber-700 dark:text-amber-300">
                <span>⚡</span> BTC Lightning
              </span>
            )}
            {aceitaCartao && (
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-purple-100 dark:bg-purple-950/70 border border-purple-300 dark:border-purple-800 text-[11px] font-bold text-purple-700 dark:text-purple-300">
                <span>💳</span> Cartão
              </span>
            )}
            {!aceitaCartao && (
              <span class="text-[10px] text-slate-400 italic">
                (Não aceitamos cartão)
              </span>
            )}
          </div>
        </div>

        <!-- Seletor de Forma de Pagamento / Botão de Ação -->
        <div class="pt-2 space-y-2">
          <!-- Tabs de método de contato/pagamento -->
          <div class="flex gap-1.5 bg-slate-200 dark:bg-slate-800 p-1 rounded-xl" role="tablist" aria-label="Método de envio do orçamento">
            <!-- Tab: WhatsApp (sempre visível) -->
            <button
              id="tab-whatsapp"
              type="button"
              role="tab"
              aria-selected="true"
              aria-controls="panel-whatsapp"
              class="checkout-tab flex-1 py-1.5 px-2 rounded-lg text-[11px] font-bold transition-all bg-white dark:bg-slate-700 text-emerald-700 dark:text-emerald-300 shadow-sm"
            >
              💬 WhatsApp
            </button>
            {aceitaPix && (
              <button
                id="tab-pix"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="panel-pix"
                class="checkout-tab flex-1 py-1.5 px-2 rounded-lg text-[11px] font-bold transition-all text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400"
              >
                💠 PIX
              </button>
            )}
            {aceitaLightning && (
              <button
                id="tab-lightning"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="panel-lightning"
                class="checkout-tab flex-1 py-1.5 px-2 rounded-lg text-[11px] font-bold transition-all text-slate-500 dark:text-slate-400 hover:text-amber-600 dark:hover:text-amber-400"
              >
                ⚡ BTC
              </button>
            )}
          </div>

          <!-- Painel WhatsApp -->
          <div id="panel-whatsapp" role="tabpanel" aria-labelledby="tab-whatsapp">
            <button
              id="btn-finalizar-whatsapp"
              type="button"
              class="w-full py-3.5 px-4 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-black text-sm flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/25 transition-all transform hover:scale-[1.01] active:scale-95"
            >
              <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
              <span>Enviar Orçamento no WhatsApp</span>
            </button>
          </div>

          <!-- Painel PIX (se ativo) -->
          {aceitaPix && (
            <div id="panel-pix" role="tabpanel" aria-labelledby="tab-pix" class="hidden">
              <button
                id="btn-pagar-pix"
                type="button"
                class="w-full py-3.5 px-4 rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-black text-sm flex items-center justify-center gap-2 shadow-lg shadow-blue-600/25 transition-all transform hover:scale-[1.01] active:scale-95"
              >
                <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
                  <path d="M12.003 2.003a2.4 2.4 0 00-1.697.703L3.71 9.302a2.4 2.4 0 000 3.395l6.596 6.596a2.4 2.4 0 003.395 0l6.596-6.596a2.4 2.4 0 000-3.395L13.7 2.706a2.4 2.4 0 00-1.697-.703zm0 4.195l4.5 4.5-4.5 4.5-4.5-4.5 4.5-4.5z"/>
                </svg>
                <span>Pagar Sinal via PIX</span>
              </button>
            </div>
          )}

          <!-- Painel Bitcoin Lightning (se ativo) -->
          {aceitaLightning && (
            <div id="panel-lightning" role="tabpanel" aria-labelledby="tab-lightning" class="hidden">
              <button
                id="btn-pagar-lightning"
                type="button"
                class="w-full py-3.5 px-4 rounded-2xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-white font-black text-sm flex items-center justify-center gap-2 shadow-lg shadow-amber-500/25 transition-all transform hover:scale-[1.01] active:scale-95"
              >
                <span class="text-lg leading-none">⚡</span>
                <span>Pagar Sinal com Bitcoin Lightning</span>
              </button>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal de Pagamento com PIX -->
<div
  id="pix-modal-container"
  class="fixed inset-0 z-[60] hidden items-end sm:items-center justify-center sm:p-4 bg-slate-950/80 backdrop-blur-sm"
>
  <div class="relative w-full sm:max-w-lg bg-white dark:bg-[#0c1527] rounded-t-3xl sm:rounded-3xl p-5 sm:p-8 border border-slate-200 dark:border-blue-950 shadow-2xl text-slate-900 dark:text-white max-h-[90vh] overflow-y-auto">
    <!-- Fechar Modal -->
    <button
      id="pix-modal-close"
      type="button"
      class="absolute top-4 right-4 p-2 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition"
    >
      <svg class="w-5 h-5 fill-none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>

    <div class="flex items-center gap-3 mb-4">
      <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800 flex items-center justify-center text-blue-600 dark:text-blue-400 shrink-0">
        <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current" viewBox="0 0 24 24">
          <path d="M12.003 2.003a2.4 2.4 0 00-1.697.703L3.71 9.302a2.4 2.4 0 000 3.395l6.596 6.596a2.4 2.4 0 003.395 0l6.596-6.596a2.4 2.4 0 000-3.395L13.7 2.706a2.4 2.4 0 00-1.697-.703zm0 4.195l4.5 4.5-4.5 4.5-4.5-4.5 4.5-4.5z"/>
        </svg>
      </div>
      <div>
        <h3 class="text-lg sm:text-xl font-black">Pagamento de Sinal PIX</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">Garantia e início da produção artesanal</p>
      </div>
    </div>

    <!-- Valor em Destaque -->
    <div class="bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800/80 rounded-2xl p-3 sm:p-4 text-center mb-4 sm:mb-6">
      <span class="text-xs font-bold uppercase tracking-wider text-blue-800 dark:text-blue-300">Valor Estimado do Pedido</span>
      <div id="pix-modal-total" class="text-2xl sm:text-3xl font-black text-blue-700 dark:text-blue-400 mt-0.5">
        R$ 0,00
      </div>
    </div>

    <!-- QR Code PIX -->
    <div class="flex flex-col sm:flex-row items-center gap-4 p-3 sm:p-4 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 mb-4 sm:mb-6">
      <div class="w-28 h-28 sm:w-36 sm:h-36 bg-white p-2 rounded-xl shadow-sm border border-slate-200 shrink-0 flex items-center justify-center">
        <img
          id="pix-qrcode-img"
          src=""
          alt="QR Code PIX para pagamento"
          class="w-full h-full object-contain"
        />
      </div>

      <div class="space-y-1.5 text-xs text-slate-600 dark:text-slate-300 flex-1 text-center sm:text-left">
        <div>
          <span class="font-bold text-slate-900 dark:text-white block">Beneficiário:</span>
          <span>{loja.titularPix}</span>
        </div>
        <div>
          <span class="font-bold text-slate-900 dark:text-white block">Tipo de Chave:</span>
          <span>{loja.tipoChavePix}</span>
        </div>
        <div>
          <span class="font-bold text-slate-900 dark:text-white block">Chave PIX:</span>
          <span class="font-mono text-blue-700 dark:text-blue-400 font-bold select-all break-all">{loja.chavePix}</span>
        </div>
      </div>
    </div>

    <!-- Chave PIX Copia e Cola -->
    <div class="mb-4 sm:mb-6 space-y-1.5">
      <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        Chave PIX (Telefone)
      </label>
      <div class="flex gap-2">
        <input
          type="text"
          id="pix-chave-input"
          readonly
          value={loja.chavePix}
          class="flex-1 px-3 py-2.5 text-xs font-mono rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 focus:outline-none min-w-0"
        />
        <button
          id="btn-copiar-pix"
          type="button"
          class="px-3 sm:px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs shrink-0 transition"
        >
          Copiar
        </button>
      </div>
      <span id="pix-copiado-feedback" class="hidden text-xs font-bold text-emerald-600">✓ Chave copiada com sucesso!</span>
    </div>

    <!-- Botão de Confirmação no WhatsApp -->
    <div class="space-y-2">
      <button
        id="btn-confirmar-pix-whatsapp"
        type="button"
        class="w-full py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-black text-sm flex items-center justify-center gap-2 shadow-lg transition active:scale-95"
      >
        <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        <span>Confirmar Orçamento + PIX no WhatsApp</span>
      </button>
      <p class="text-[11px] text-center text-slate-400">
        Nossa equipe responderá com o cronograma de produção e agendamento!
      </p>
    </div>
  </div>
</div>

<!-- Modal de Pagamento com ⚡ Bitcoin Lightning Network -->
<div
  id="lightning-modal-container"
  class="fixed inset-0 z-[60] hidden items-end sm:items-center justify-center sm:p-4 bg-slate-950/85 backdrop-blur-sm"
>
  <div class="relative w-full sm:max-w-lg bg-white dark:bg-[#0c1527] rounded-t-3xl sm:rounded-3xl p-5 sm:p-8 border border-slate-200 dark:border-amber-950/60 shadow-2xl text-slate-900 dark:text-white max-h-[90vh] overflow-y-auto">
    <!-- Fechar Modal -->
    <button
      id="lightning-modal-close"
      type="button"
      class="absolute top-4 right-4 p-2 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>

    <div class="flex items-center gap-3 mb-4">
      <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-700 flex items-center justify-center text-2xl shrink-0">
        ⚡
      </div>
      <div>
        <h3 class="text-lg sm:text-xl font-black">Pagar com Bitcoin Lightning</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">Pagamento instantâneo via Lightning Network (BTC)</p>
      </div>
    </div>

    <!-- Valor em Destaque -->
    <div class="bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/60 rounded-2xl p-3 sm:p-4 text-center mb-4 sm:mb-6">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-300">Valor Estimado do Pedido</span>
      <div id="lightning-modal-total" class="text-2xl sm:text-3xl font-black text-amber-700 dark:text-amber-400 mt-0.5">
        R$ 0,00
      </div>
      <p class="text-[11px] text-amber-600 dark:text-amber-400 mt-1">⚡ O valor em BTC será calculado na hora pela cotação atual</p>
    </div>

    <!-- QR Code Lightning -->
    <div class="flex flex-col sm:flex-row items-center gap-4 p-3 sm:p-4 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 mb-4 sm:mb-6">
      <div class="w-28 h-28 sm:w-36 sm:h-36 bg-white p-2 rounded-xl shadow-sm border border-slate-200 shrink-0 flex items-center justify-center">
        <img
          id="lightning-qrcode-img"
          src=""
          alt="QR Code Bitcoin Lightning para pagamento"
          class="w-full h-full object-contain"
        />
      </div>

      <div class="space-y-2 text-xs text-slate-600 dark:text-slate-300 flex-1 text-center sm:text-left">
        <div>
          <span class="font-bold text-slate-900 dark:text-white block">Endereço Lightning:</span>
          <span class="font-mono text-amber-700 dark:text-amber-400 font-bold select-all break-all">{enderecoLightning}</span>
        </div>
        <p class="text-[11px] text-slate-400 dark:text-slate-500 pt-1">
          Escaneie o QR com sua carteira Lightning (Phoenix, Zeus, Wallet of Satoshi, Muun, etc.)
        </p>
      </div>
    </div>

    <!-- Endereço Lightning Copia e Cola -->
    <div class="mb-4 sm:mb-6 space-y-1.5">
      <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        Endereço Lightning (copiar)
      </label>
      <div class="flex gap-2">
        <input
          type="text"
          id="lightning-address-input"
          readonly
          value={enderecoLightning}
          class="flex-1 px-3 py-2.5 text-xs font-mono rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 focus:outline-none min-w-0"
        />
        <button
          id="btn-copiar-lightning"
          type="button"
          class="px-3 sm:px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-white font-bold text-xs shrink-0 transition"
        >
          Copiar
        </button>
      </div>
      <span id="lightning-copiado-feedback" class="hidden text-xs font-bold text-emerald-600">✓ Endereço Lightning copiado!</span>
    </div>

    <!-- Botão de Confirmação no WhatsApp -->
    <div class="space-y-2">
      <button
        id="btn-confirmar-lightning-whatsapp"
        type="button"
        class="w-full py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-black text-sm flex items-center justify-center gap-2 shadow-lg transition active:scale-95"
      >
        <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        <span>⚡ Confirmar Orçamento + Lightning no WhatsApp</span>
      </button>
      <p class="text-[11px] text-center text-slate-400">
        Envie o comprovante do pagamento Bitcoin pelo WhatsApp para confirmar seu pedido!
      </p>
    </div>
  </div>
</div>

<script define:vars={{ lojaWhatsapp: loja.whatsapp, chavePix: loja.chavePix, titularPix: loja.titularPix, lojaNome: loja.nomeLoja, endLightning: enderecoLightning }}>
  const STORAGE_KEY = 'bompreco_cart_v1';

  function getCart() {
    try {
      const data = localStorage.getItem(STORAGE_KEY);
      return data ? JSON.parse(data) : [];
    } catch {
      return [];
    }
  }

  function saveCart(cart) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart } }));
    } catch (e) {
      console.error('Erro ao salvar orçamento:', e);
    }
  }

  // Elementos do DOM
  const drawerContainer = document.getElementById('cart-drawer-container');
  const cartBackdrop = document.getElementById('cart-backdrop');
  const cartPanel = document.getElementById('cart-panel');
  const cartCloseBtn = document.getElementById('cart-close-btn');
  const cartItemsList = document.getElementById('cart-items-list');
  const cartEmptyState = document.getElementById('cart-empty-state');
  const cartFooter = document.getElementById('cart-footer');
  const cartItemsCountHeader = document.getElementById('cart-items-count-header');
  const cartSubtotal = document.getElementById('cart-subtotal');
  const cartTotal = document.getElementById('cart-total');
  const cartEmptyExploreBtn = document.getElementById('cart-empty-explore-btn');

  // Modal PIX
  const pixModalContainer = document.getElementById('pix-modal-container');
  const pixModalClose = document.getElementById('pix-modal-close');
  const pixModalTotal = document.getElementById('pix-modal-total');
  const pixQrcodeImg = document.getElementById('pix-qrcode-img');
  const btnPagarPix = document.getElementById('btn-pagar-pix');
  const btnCopiarPix = document.getElementById('btn-copiar-pix');
  const pixCopiadoFeedback = document.getElementById('pix-copiado-feedback');
  const btnConfirmarPixWhatsapp = document.getElementById('btn-confirmar-pix-whatsapp');
  const btnFinalizarWhatsapp = document.getElementById('btn-finalizar-whatsapp');

  // Modal Lightning
  const lightningModalContainer = document.getElementById('lightning-modal-container');
  const lightningModalClose = document.getElementById('lightning-modal-close');
  const lightningModalTotal = document.getElementById('lightning-modal-total');
  const lightningQrcodeImg = document.getElementById('lightning-qrcode-img');
  const btnPagarLightning = document.getElementById('btn-pagar-lightning');
  const btnCopiarLightning = document.getElementById('btn-copiar-lightning');
  const lightningCopiadoFeedback = document.getElementById('lightning-copiado-feedback');
  const btnConfirmarLightningWhatsapp = document.getElementById('btn-confirmar-lightning-whatsapp');
  const inputEndereco = document.getElementById('cart-cliente-endereco');

  function formatBRL(val) {
    return val.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  }

  function openCart() {
    if (!drawerContainer || !cartPanel) return;
    drawerContainer.classList.remove('pointer-events-none', 'opacity-0');
    drawerContainer.classList.add('opacity-100');
    cartPanel.classList.remove('translate-x-full');
    drawerContainer.removeAttribute('aria-hidden');
    // Mover o foco para o botão de fechar após a animação
    setTimeout(() => cartCloseBtn?.focus(), 50);
    // Bloquear scroll do body no mobile
    document.body.style.overflow = 'hidden';
    renderCart();
  }

  function closeCart() {
    if (!drawerContainer || !cartPanel) return;
    cartPanel.classList.add('translate-x-full');
    drawerContainer.classList.remove('opacity-100');
    drawerContainer.classList.add('opacity-0', 'pointer-events-none');
    // Restaurar aria-hidden depois da animação (300ms = duração do transition)
    setTimeout(() => {
      drawerContainer.setAttribute('aria-hidden', 'true');
    }, 310);
    // Restaurar scroll do body
    document.body.style.overflow = '';
  }

  function renderCart() {
    const cart = getCart();
    if (!cartItemsList || !cartEmptyState || !cartFooter || !cartItemsCountHeader) return;

    const totalItens = cart.reduce((acc, item) => acc + item.quantidade, 0);
    cartItemsCountHeader.textContent = `${totalItens} ${totalItens === 1 ? 'peça na lista' : 'peças na lista'}`;

    if (cart.length === 0) {
      cartItemsList.innerHTML = '';
      cartItemsList.classList.add('hidden');
      cartFooter.classList.add('hidden');
      cartEmptyState.classList.remove('hidden');
      return;
    }

    cartEmptyState.classList.add('hidden');
    cartItemsList.classList.remove('hidden');
    cartFooter.classList.remove('hidden');

    let totalGeral = 0;

    cartItemsList.innerHTML = cart
      .map((item) => {
        const itemTotal = item.preco * item.quantidade;
        totalGeral += itemTotal;

        return `
          <div class="flex items-center gap-3 p-3 bg-slate-50 dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-blue-950">
            <img src="${item.imagem}" alt="${item.nome}" class="w-14 h-14 object-cover rounded-xl shrink-0 border border-slate-200 dark:border-slate-800" />
            <div class="flex-1 min-w-0">
              <h4 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white truncate">${item.nome}</h4>
              <span class="text-[11px] text-slate-500 dark:text-slate-400 block">${formatBRL(item.preco)} / ${item.unidade}</span>
              <div class="flex items-center gap-2 mt-1.5">
                <div class="flex items-center border border-slate-200 dark:border-slate-800 rounded-lg bg-white dark:bg-slate-950">
                  <button class="cart-qtd-btn px-2 py-0.5 text-xs text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-l" data-slug="${item.slug}" data-delta="-1">-</button>
                  <span class="px-2 text-xs font-bold text-slate-800 dark:text-white">${item.quantidade}</span>
                  <button class="cart-qtd-btn px-2 py-0.5 text-xs text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-r" data-slug="${item.slug}" data-delta="1">+</button>
                </div>
                <span class="text-xs font-extrabold text-blue-600 dark:text-blue-400 ml-auto">${formatBRL(itemTotal)}</span>
              </div>
            </div>
            <button class="cart-remove-btn text-slate-400 hover:text-red-500 p-1.5 transition" data-slug="${item.slug}" title="Remover item">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </button>
          </div>
        `;
      })
      .join('');

    if (cartSubtotal) cartSubtotal.textContent = formatBRL(totalGeral);
    if (cartTotal) cartTotal.textContent = formatBRL(totalGeral);

    document.querySelectorAll('.cart-qtd-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        const slug = target.getAttribute('data-slug');
        const delta = parseInt(target.getAttribute('data-delta') || '0', 10);
        alterarQuantidade(slug, delta);
      });
    });

    document.querySelectorAll('.cart-remove-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        const slug = target.getAttribute('data-slug');
        removerItem(slug);
      });
    });
  }

  function alterarQuantidade(slug, delta) {
    let cart = getCart();
    const item = cart.find((i) => i.slug === slug);
    if (!item) return;

    item.quantidade += delta;
    if (item.quantidade <= 0) {
      cart = cart.filter((i) => i.slug !== slug);
    }
    saveCart(cart);
    renderCart();
  }

  function removerItem(slug) {
    let cart = getCart();
    cart = cart.filter((i) => i.slug !== slug);
    saveCart(cart);
    renderCart();
  }

  window.carrinhoMercado = {
    adicionar(produto, abrir = false) {
      const cart = getCart();
      const existente = cart.find((i) => i.slug === produto.slug);
      if (existente) {
        existente.quantidade += 1;
      } else {
        cart.push({ ...produto, quantidade: 1 });
      }
      saveCart(cart);
      if (abrir) {
        openCart();
      }
    },
    abrir: openCart,
    fechar: closeCart,
    limpar() {
      saveCart([]);
      renderCart();
    }
  };

  cartBackdrop?.addEventListener('click', closeCart);
  cartCloseBtn?.addEventListener('click', closeCart);
  cartEmptyExploreBtn?.addEventListener('click', () => {
    closeCart();
    window.location.href = '/produtos';
  });

  btnPagarPix?.addEventListener('click', () => {
    const cart = getCart();
    if (cart.length === 0) return;

    const total = cart.reduce((acc, item) => acc + item.preco * item.quantidade, 0);
    if (pixModalTotal) pixModalTotal.textContent = formatBRL(total);

    if (pixQrcodeImg) {
      const textoPix = `Chave: ${chavePix} | Valor: ${formatBRL(total)} | Favorecido: ${titularPix}`;
      pixQrcodeImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(textoPix)}`;
    }

    pixModalContainer?.classList.remove('hidden');
    pixModalContainer?.classList.add('flex');
  });

  pixModalClose?.addEventListener('click', () => {
    pixModalContainer?.classList.add('hidden');
    pixModalContainer?.classList.remove('flex');
  });

  btnCopiarPix?.addEventListener('click', () => {
    navigator.clipboard.writeText(chavePix).then(() => {
      if (pixCopiadoFeedback) {
        pixCopiadoFeedback.classList.remove('hidden');
        setTimeout(() => pixCopiadoFeedback.classList.add('hidden'), 3500);
      }
    });
  });

  function gerarTextoOrcamento(tipoMensagem) {
    const cart = getCart();
    const endereco = inputEndereco?.value.trim() || 'Dom Pedro - MA (a combinar medição)';
    const tipoEntregaEl = document.querySelector('input[name="tipo-entrega"]:checked');
    const tipoEntrega = tipoEntregaEl ? tipoEntregaEl.value : 'instalacao';

    let total = 0;
    let lista = cart
      .map((item) => {
        const sub = item.preco * item.quantidade;
        total += sub;
        return `• *${item.quantidade}x ${item.nome}* (${item.unidade}): ~ ${formatBRL(sub)}`;
      })
      .join('\n');

    let msg = `⚒️ *SOLICITAÇÃO DE ORÇAMENTO - ${lojaNome}*\n\n`;
    msg += `📐 *Peças de Interesse:*\n${lista}\n\n`;
    msg += `💰 *Valor Estimado:* *${formatBRL(total)}*\n`;
    msg += `📍 *Modalidade:* ${tipoEntrega === 'instalacao' ? 'Instalação / Entrega na obra' : 'Retirada na serralheria'}\n`;
    msg += `🏡 *Local / Informações:* ${endereco}\n\n`;
    if (tipoMensagem === 'pix') {
      msg += `✅ *Nota:* Gostaria de formalizar o pedido com entrada/sinal via PIX!`;
    } else {
      msg += `Gostaria de tirar dúvidas sobre medidas sob medida, acabamento e prazo de entrega!`;
    }
    return encodeURIComponent(msg);
  }

  // ⚡ Lightning Network handlers
  btnPagarLightning?.addEventListener('click', () => {
    const cart = getCart();
    if (cart.length === 0) return;
    const total = cart.reduce((acc, item) => acc + item.preco * item.quantidade, 0);
    if (lightningModalTotal) lightningModalTotal.textContent = formatBRL(total);
    if (lightningQrcodeImg) {
      lightningQrcodeImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent('lightning:' + endLightning)}`;
    }
    lightningModalContainer?.classList.remove('hidden');
    lightningModalContainer?.classList.add('flex');
  });

  lightningModalClose?.addEventListener('click', () => {
    lightningModalContainer?.classList.add('hidden');
    lightningModalContainer?.classList.remove('flex');
  });

  btnCopiarLightning?.addEventListener('click', () => {
    navigator.clipboard.writeText(endLightning).then(() => {
      if (lightningCopiadoFeedback) {
        lightningCopiadoFeedback.classList.remove('hidden');
        setTimeout(() => lightningCopiadoFeedback.classList.add('hidden'), 3500);
      }
    });
  });

  btnConfirmarLightningWhatsapp?.addEventListener('click', () => {
    const cart = getCart();
    if (cart.length === 0) return;
    const total = cart.reduce((acc, item) => acc + item.preco * item.quantidade, 0);
    const endereco = document.getElementById('cart-cliente-endereco')?.value?.trim() || 'Dom Pedro - MA';
    let msg = `⚡ *PAGAMENTO BITCOIN LIGHTNING - ${lojaNome}*\n\n`;
    msg += `💰 *Valor Estimado:* ${formatBRL(total)}\n`;
    msg += `📍 *Local / Obra:* ${endereco}\n`;
    msg += `⚡ *Endereço Lightning:* ${endLightning}\n\n`;
    msg += `Estou enviando o comprovante do sinal em BTC via Lightning Network. Podemos confirmar o pedido?`;
    window.open(`https://wa.me/${lojaWhatsapp}?text=${encodeURIComponent(msg)}`, '_blank');
  });

  btnFinalizarWhatsapp?.addEventListener('click', () => {
    const msg = gerarTextoOrcamento('orcamento');
    window.open(`https://wa.me/${lojaWhatsapp}?text=${msg}`, '_blank');
  });

  btnConfirmarPixWhatsapp?.addEventListener('click', () => {
    const msg = gerarTextoOrcamento('pix');
    window.open(`https://wa.me/${lojaWhatsapp}?text=${msg}`, '_blank');
  });

  window.addEventListener('cart:updated', () => {
    renderCart();
  });

  // Inicializar aria-hidden via JS (garante estado correto desde o início)
  if (drawerContainer) drawerContainer.setAttribute('aria-hidden', 'true');

  // Fechar com tecla Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const isDrawerOpen = drawerContainer && !drawerContainer.classList.contains('pointer-events-none');
      const isPixOpen = pixModalContainer && !pixModalContainer.classList.contains('hidden');
      const isLightningOpen = lightningModalContainer && !lightningModalContainer.classList.contains('hidden');
      if (isLightningOpen) {
        lightningModalContainer.classList.add('hidden');
        lightningModalContainer.classList.remove('flex');
      } else if (isPixOpen) {
        pixModalContainer.classList.add('hidden');
        pixModalContainer.classList.remove('flex');
      } else if (isDrawerOpen) {
        closeCart();
      }
    }
  });

  // === Lógica das Tabs de Checkout ===
  const checkoutTabs = document.querySelectorAll('.checkout-tab');
  const checkoutPanels = ['panel-whatsapp', 'panel-pix', 'panel-lightning']
    .map(id => document.getElementById(id))
    .filter(Boolean);

  function activateTab(selectedTab) {
    checkoutTabs.forEach(tab => {
      const isSelected = tab === selectedTab;
      tab.setAttribute('aria-selected', String(isSelected));
      if (isSelected) {
        tab.classList.add('bg-white', 'dark:bg-slate-700', 'shadow-sm');
        tab.classList.remove('text-slate-500', 'dark:text-slate-400');
        // Color the active tab based on its id
        tab.classList.remove('text-emerald-700', 'dark:text-emerald-300', 'text-blue-600', 'dark:text-blue-400', 'text-amber-600', 'dark:text-amber-400');
        if (tab.id === 'tab-whatsapp') tab.classList.add('text-emerald-700', 'dark:text-emerald-300');
        else if (tab.id === 'tab-pix') tab.classList.add('text-blue-600', 'dark:text-blue-400');
        else if (tab.id === 'tab-lightning') tab.classList.add('text-amber-600', 'dark:text-amber-400');
      } else {
        tab.classList.remove('bg-white', 'dark:bg-slate-700', 'shadow-sm');
        tab.classList.add('text-slate-500', 'dark:text-slate-400');
        tab.classList.remove('text-emerald-700', 'dark:text-emerald-300', 'text-blue-600', 'dark:text-blue-400', 'text-amber-600', 'dark:text-amber-400');
      }
    });

    const panelId = selectedTab.getAttribute('aria-controls');
    checkoutPanels.forEach(panel => {
      panel.classList.toggle('hidden', panel.id !== panelId);
    });
  }

  checkoutTabs.forEach(tab => {
    tab.addEventListener('click', () => activateTab(tab));
  });
  // === Fim das Tabs ===

  renderCart();
</script>
