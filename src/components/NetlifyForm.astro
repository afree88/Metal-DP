---
interface Props {
  whatsapp?: string;
}

const { whatsapp = '559991756968' } = Astro.props;
---

<div class="bg-white dark:bg-[#0c1527] rounded-3xl p-6 sm:p-10 border border-slate-200/80 dark:border-blue-950/80 shadow-card">
  <div class="mb-6">
    <span class="inline-block text-xs uppercase tracking-wider font-bold text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/70 border border-blue-200 dark:border-blue-800 px-3 py-1 rounded-full mb-2">
      Orçamento Imediato via WhatsApp
    </span>
    <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">Envie os Detalhes do seu Projeto</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
      Preencha o formulário abaixo e clique no botão para enviar todas as informações diretamente no WhatsApp da serralheria!
    </p>
  </div>

  <form
    id="form-projeto-whatsapp"
    class="space-y-4"
  >
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="projeto-nome" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
          Seu Nome Completo *
        </label>
        <input
          type="text"
          id="projeto-nome"
          name="nome"
          required
          placeholder="Ex: João Ferreira"
          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/90 text-sm text-slate-900 dark:text-white focus:bg-white dark:focus:bg-slate-950 focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
        />
      </div>

      <div>
        <label for="projeto-contato" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
          Seu WhatsApp *
        </label>
        <input
          type="text"
          id="projeto-contato"
          name="contato"
          required
          placeholder="(99) 90000-0000"
          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/90 text-sm text-slate-900 dark:text-white focus:bg-white dark:focus:bg-slate-950 focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
        />
      </div>
    </div>

    <div>
      <label for="projeto-tipo" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
        Tipo de Peça ou Obra Desejada
      </label>
      <select
        id="projeto-tipo"
        name="tipo"
        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/90 text-sm text-slate-900 dark:text-white focus:bg-white dark:focus:bg-slate-950 focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
      >
        <option value="Portão Colonial ou Basculante">Portão Colonial, Deslizante ou Basculante</option>
        <option value="Guarda-Corpo ou Corrimão Artístico">Guarda-Corpo ou Corrimão Artístico</option>
        <option value="Grades Ornamentais para Janelas ou Sacadas">Grades Ornamentais para Janelas ou Sacadas</option>
        <option value="Mesa ou Móveis em Ferro e Madeira">Mesa ou Móveis em Ferro e Madeira</option>
        <option value="Pergolado ou Gazebo em Ferro">Pergolado ou Gazebo Arquitetônico</option>
        <option value="Painel Decorativo, Escultura ou Brise">Painel Decorativo, Escultura ou Brise</option>
        <option value="Luminárias ou Lustres Forjados">Luminárias ou Lustres Forjados</option>
        <option value="Outro Projeto Sob Medida">Outro Projeto Sob Medida</option>
      </select>
    </div>

    <div>
      <label for="projeto-mensagem" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
        Medidas Aproximadas & Detalhes da Ideia *
      </label>
      <textarea
        id="projeto-mensagem"
        name="mensagem"
        rows="4"
        required
        placeholder="Descreva as medidas aproximadas (altura x largura), acabamento desejado (preto fosco, azul grafite, pátina bronze) e local de instalação..."
        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/90 text-sm text-slate-900 dark:text-white focus:bg-white dark:focus:bg-slate-950 focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
      ></textarea>
    </div>

    <button
      type="submit"
      class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 bg-emerald-600 hover:bg-emerald-500 text-white font-black text-sm rounded-2xl shadow-lg shadow-emerald-600/30 hover:scale-[1.02] active:scale-95 transition-all duration-200 focus:outline-none focus:ring-4 focus:ring-emerald-300"
    >
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
      <span>Enviar Detalhes no WhatsApp</span>
    </button>
  </form>
</div>

<script define:vars={{ whatsappTarget: whatsapp }}>
  const form = document.getElementById('form-projeto-whatsapp');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const nome = (document.getElementById('projeto-nome')?.value || '').trim();
    const contato = (document.getElementById('projeto-contato')?.value || '').trim();
    const tipo = (document.getElementById('projeto-tipo')?.value || '').trim();
    const mensagem = (document.getElementById('projeto-mensagem')?.value || '').trim();

    if (!nome || !mensagem) {
      alert('Por favor, preencha seu nome e a descrição do projeto.');
      return;
    }

    let texto = `⚒️ *SOLICITAÇÃO DE PROJETO & ORÇAMENTO - METAL DP*\n\n`;
    texto += `👤 *Nome:* ${nome}\n`;
    texto += `📱 *Telefone/WhatsApp:* ${contato || 'Não informado'}\n`;
    texto += `🏗️ *Tipo de Peça:* ${tipo}\n\n`;
    texto += `📐 *Medidas & Detalhes da Ideia:*\n${mensagem}\n\n`;
    texto += `Gostaria de saber a estimativa de valores, prazo de fabricação e tirar dúvidas!`;

    const encoded = encodeURIComponent(texto);
    const url = `https://wa.me/${whatsappTarget}?text=${encoded}`;

    window.open(url, '_blank');
  });
</script>
