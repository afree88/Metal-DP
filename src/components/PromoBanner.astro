---
interface Props {
  loja: {
    bannerTitulo: string;
    bannerSubtitulo: string;
    whatsapp: string;
  };
}

const { loja } = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-[#040813] via-[#09152b] to-[#0d1e3d] text-white rounded-2xl sm:rounded-3xl mx-2.5 sm:mx-6 lg:mx-8 my-3 sm:my-6 shadow-2xl border border-blue-900/40 isolate max-w-[calc(100vw-1.25rem)] sm:max-w-none">
  
  <!-- Canvas com faíscas azuis animadas da solda -->
  <canvas id="forge-sparks-canvas" class="absolute inset-0 w-full h-full pointer-events-none opacity-45"></canvas>

  <!-- Brilho de fundo azul e ciano elétrico -->
  <div class="absolute -top-32 -left-32 w-80 sm:w-96 h-80 sm:h-96 bg-blue-600/25 rounded-full blur-3xl pointer-events-none animate-pulse"></div>
  <div class="absolute -bottom-32 -right-32 w-80 sm:w-96 h-80 sm:h-96 bg-cyan-600/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-3.5 sm:px-6 py-7 sm:py-16 lg:py-20 flex flex-col lg:flex-row items-center justify-between gap-6 sm:gap-12">
    <div class="max-w-2xl text-center lg:text-left w-full z-10">
      
      <!-- Tag / Badge com animação azul-aço -->
      <div class="inline-flex items-center justify-center gap-1.5 sm:gap-2 bg-gradient-to-r from-blue-500/20 to-cyan-500/20 border border-blue-400/50 text-cyan-300 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full text-[10px] sm:text-xs font-black mb-3 sm:mb-6 shadow-lg tracking-wide uppercase max-w-full">
        <span class="flex h-2 w-2 rounded-full bg-cyan-400 animate-ping shrink-0"></span>
        <span class="truncate">SERRALHERIA SOB MEDIDA & PROJETOS EM METAL</span>
      </div>

      <!-- Título Principal com contraste e elegância -->
      <h1 class="text-2xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight font-heading drop-shadow-md break-words">
        {loja.bannerTitulo || 'Serralheria Artística com Força, Elegância e Precisão'}
      </h1>

      <!-- Subtítulo refinado e legível -->
      <p class="mt-3 sm:mt-6 text-xs sm:text-lg text-slate-200 font-medium leading-relaxed max-w-xl">
        {loja.bannerSubtitulo || 'Portões, corrimãos, grades, móveis industriais e peças decorativas com solda MMA reforçada e pintura automotiva no compressor em Dom Pedro - MA.'}
      </p>

      <!-- Botões de Ação -->
      <div class="mt-5 sm:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-2.5 sm:gap-4 w-full">
        <a
          href="/produtos"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 sm:px-6 sm:py-4 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-black text-xs sm:text-base shadow-xl shadow-blue-600/30 hover:scale-[1.02] active:scale-95 transition-all duration-200"
        >
          <span>Explorar Catálogo de Peças</span>
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>

        <a
          href={`https://wa.me/${loja.whatsapp}?text=${encodeURIComponent('Olá! Gostaria de solicitar um orçamento de serralheria na Metal DP.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 sm:px-6 sm:py-4 rounded-xl bg-slate-900/90 hover:bg-slate-900 text-white font-bold text-xs sm:text-base border border-blue-400/40 hover:border-cyan-400/70 transition-all duration-200 shadow-md hover:scale-[1.02]"
        >
          <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current text-emerald-400" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          <span>Pedir Orçamento no WhatsApp</span>
        </a>
      </div>

      <!-- Diferenciais em Caixas -->
      <div class="mt-6 sm:mt-12 grid grid-cols-3 gap-2 sm:gap-4 pt-5 sm:pt-6 border-t border-blue-900/40 text-left">
        <div class="bg-black/50 border border-blue-500/25 rounded-xl p-2.5 sm:p-4 backdrop-blur-sm">
          <span class="block text-sm sm:text-2xl font-black text-blue-400 leading-tight">Solda MMA</span>
          <span class="text-[10px] sm:text-xs text-slate-300 font-semibold block mt-0.5">Eletrodo resistente</span>
        </div>
        <div class="bg-black/50 border border-blue-500/25 rounded-xl p-2.5 sm:p-4 backdrop-blur-sm">
          <span class="block text-sm sm:text-2xl font-black text-blue-400 leading-tight">Sob Medida</span>
          <span class="text-[10px] sm:text-xs text-slate-300 font-semibold block mt-0.5">Design exclusivo</span>
        </div>
        <div class="bg-black/50 border border-blue-500/25 rounded-xl p-2.5 sm:p-4 backdrop-blur-sm">
          <span class="block text-sm sm:text-2xl font-black text-blue-400 leading-tight">Compressor</span>
          <span class="text-[10px] sm:text-xs text-slate-300 font-semibold block mt-0.5">Pintura automotiva</span>
        </div>
      </div>
    </div>

    <!-- Imagem Hero em Destaque -->
    <div class="relative w-full lg:w-auto flex-1 max-w-md lg:max-w-lg z-10">
      <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden border-2 border-blue-500/40 shadow-2xl shadow-blue-950/60 group">
        <img
          src="https://images.unsplash.com/photo-1509198397868-475647b2a1e5?auto=format&fit=crop&w=800&q=80"
          alt="Serralheiro especializado trabalhando metal"
          class="w-full h-52 sm:h-96 object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
        <div class="absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4 bg-slate-950/85 backdrop-blur-md p-3 sm:p-3.5 rounded-xl sm:rounded-2xl border border-blue-500/30">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-[10px] sm:text-xs uppercase font-extrabold text-cyan-400">Oficina & Criação</p>
              <p class="text-xs sm:text-sm font-bold text-white">Dom Pedro - Maranhão</p>
            </div>
            <span class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-lg bg-blue-500/20 text-cyan-300 text-[10px] sm:text-xs font-bold border border-cyan-400/30">
              Sob Medida
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Script para faíscas azuis elétricas da oficina -->
<script>
  const canvas = document.getElementById('forge-sparks-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    let animationFrameId: number;
    let width = (canvas.width = canvas.offsetWidth);
    let height = (canvas.height = canvas.offsetHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = canvas.offsetWidth;
      height = canvas.height = canvas.offsetHeight;
    });

    interface Spark {
      x: number;
      y: number;
      size: number;
      speedY: number;
      speedX: number;
      opacity: number;
      hue: number;
    }

    const sparks: Spark[] = [];
    const count = 30;

    for (let i = 0; i < count; i++) {
      sparks.push({
        x: Math.random() * width,
        y: Math.random() * height,
        size: Math.random() * 2.2 + 1,
        speedY: -(Math.random() * 1.5 + 0.4),
        speedX: (Math.random() - 0.5) * 0.8,
        opacity: Math.random() * 0.8 + 0.2,
        hue: Math.floor(Math.random() * 30 + 195), // Tons de Azul e Ciano Elétrico
      });
    }

    function render() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < sparks.length; i++) {
        const s = sparks[i];
        s.y += s.speedY;
        s.x += s.speedX;

        if (s.y < -10) {
          s.y = height + 10;
          s.x = Math.random() * width;
        }

        ctx.beginPath();
        ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
        ctx.fillStyle = `hsla(${s.hue}, 100%, 65%, ${s.opacity})`;
        ctx.shadowBlur = 8;
        ctx.shadowColor = `hsl(${s.hue}, 100%, 55%)`;
        ctx.fill();
      }

      animationFrameId = requestAnimationFrame(render);
    }

    render();
  }
</script>
