---
interface Props {
  loja: {
    nomeLoja: string;
    slogan?: string;
    telefone: string;
    whatsapp: string;
    endereco: string;
    horarioSemana: string;
    bannerAviso?: string | null;
  };
}

const { loja } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Início', href: '/' },
  { name: 'Galeria & Peças', href: '/produtos' },
  { name: 'Sobre Nós', href: '/sobre' },
  { name: 'Onde Estamos', href: '/localizacao' },
  { name: 'Orçamentos & Contato', href: '/contato' },
];
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200 dark:border-blue-950/80 bg-white/95 dark:bg-[#080d1a]/95 backdrop-blur-md shadow-sm transition-colors duration-200">
  <!-- Top bar com avisos e horários -->
  <div class="bg-slate-950 dark:bg-[#040812] text-white text-xs py-1.5 sm:py-2 px-3 sm:px-4 border-b border-blue-900/30 overflow-hidden">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2 overflow-hidden">
      <div class="flex items-center gap-2 sm:gap-4 min-w-0 flex-1">
        {loja.bannerAviso && (
          <span class="font-bold bg-blue-950/90 border border-blue-500/40 px-2 sm:px-2.5 py-0.5 rounded-full text-blue-300 flex items-center gap-1.5 shadow-sm text-[10px] sm:text-xs truncate">
            <span class="shrink-0">✨</span> <span class="truncate">{loja.bannerAviso}</span>
          </span>
        )}
      </div>
      <div class="hidden sm:flex items-center gap-4 text-slate-300 shrink-0">
        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          {loja.horarioSemana}
        </span>
        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          {loja.telefone}
        </span>
      </div>
    </div>
  </div>

  <!-- Cabeçalho Principal -->
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-2 sm:py-3.5 flex items-center justify-between gap-1.5 sm:gap-4 overflow-hidden">
    <!-- Logo com Ícone em Tons de Azul -->
    <a href="/" class="flex items-center gap-2 group min-w-0 shrink">
      <div class="w-9 h-9 sm:w-11 sm:h-11 rounded-xl bg-gradient-to-br from-blue-500 via-blue-600 to-indigo-800 flex items-center justify-center text-white shadow-md shadow-blue-600/30 group-hover:scale-105 transition-all shrink-0">
        <svg class="w-5 h-5 sm:w-6 sm:h-6 fill-current text-white" viewBox="0 0 24 24">
          <path d="M19 7h-1V5a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2H5a3 3 0 0 0-3 3v2a1 1 0 0 0 1 1h1.1a5.98 5.98 0 0 0 4.9 2.9V18H7a1 1 0 0 0-1 1v1h12v-1a1 1 0 0 0-1-1h-2v-2.1a5.98 5.98 0 0 0 4.9-2.9H21a1 1 0 0 0 1-1v-2a3 3 0 0 0-3-3zM8 6h8v1H8V6zm11 6h-2.18a6.04 6.04 0 0 0 .18-1.5c0-.17-.02-.33-.04-.5H20a1 1 0 0 1 1 1v1h-2zm-15-1a1 1 0 0 1 1-1h3.04c-.02.17-.04.33-.04.5 0 .52.06 1.02.18 1.5H4v-1zm9 8v-1.1a7.93 7.93 0 0 0 2-.9V19h-4z"/>
        </svg>
      </div>
      <div class="min-w-0">
        <span class="text-base sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight block leading-tight truncate">
          Metal <span class="text-blue-600 dark:text-blue-400">DP</span>
        </span>
        <span class="text-[9px] sm:text-[11px] text-blue-700 dark:text-blue-300 font-bold tracking-wider uppercase block truncate">Serralheria Artística</span>
      </div>
    </a>

    <!-- Barra de Busca Rápida (Desktop e Tablet) -->
    <form action="/produtos" method="get" class="hidden md:flex flex-1 max-w-md mx-4">
      <div class="relative w-full">
        <input
          type="text"
          name="busca"
          placeholder="Buscar portão, corrimão, pergolado, móveis..."
          class="w-full pl-10 pr-4 py-2 text-sm bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-blue-950 rounded-full text-slate-900 dark:text-white focus:bg-white dark:focus:bg-slate-950 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors"
        />
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
    </form>

    <!-- Botões de Ação do Header -->
    <div class="flex items-center gap-1 sm:gap-3 shrink-0">
      
      <!-- Botão Alternador Tema Dark / Light -->
      <button
        id="theme-toggle-btn"
        type="button"
        class="p-2 sm:p-2.5 rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-blue-950 transition"
        aria-label="Alternar tema claro/escuro"
        title="Alternar tema claro/escuro"
      >
        <svg id="theme-sun-icon" class="w-4 h-4 sm:w-5 sm:h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="theme-moon-icon" class="w-4 h-4 sm:w-5 sm:h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Botão Lista de Orçamento -->
      <button
        id="cart-header-btn"
        type="button"
        class="relative flex items-center gap-1 sm:gap-2 px-2 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/60 text-blue-900 dark:text-blue-200 font-bold text-xs sm:text-sm hover:bg-blue-100 dark:hover:bg-blue-900/60 transition"
        aria-label="Abrir lista de orçamento"
      >
        <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
        </svg>
        <span class="hidden sm:inline">Orçamento</span>
        <span
          id="cart-header-badge"
          class="hidden px-1.5 py-0.5 text-[10px] sm:text-[11px] font-black rounded-full bg-blue-600 text-white min-w-[18px] sm:min-w-[20px] text-center"
        >
          0
        </span>
      </button>

      <!-- WhatsApp Rápido -->
      <a
        href={`https://wa.me/${loja.whatsapp}?text=${encodeURIComponent('Olá! Gostaria de solicitar um orçamento para peças de serralheria artística da Metal DP.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden lg:inline-flex items-center gap-2 px-3.5 py-2 text-xs font-bold text-emerald-900 dark:text-emerald-200 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-300 dark:border-emerald-800 rounded-xl hover:bg-emerald-100 dark:hover:bg-emerald-900 transition"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Orçamento WhatsApp</span>
      </a>

      <!-- Botão Hambúrguer Mobile -->
      <button
        id="mobile-menu-button"
        type="button"
        class="md:hidden p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:text-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none"
        aria-label="Abrir menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Barra de Busca Mobile -->
  <div class="md:hidden px-4 pb-3">
    <form action="/produtos" method="get">
      <div class="relative w-full">
        <input
          type="text"
          name="busca"
          placeholder="Buscar portões, corrimãos, mesas..."
          class="w-full pl-9 pr-4 py-2 text-sm bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-blue-950 rounded-lg text-slate-900 dark:text-white focus:bg-white dark:focus:bg-slate-950 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
    </form>
  </div>

  <!-- Barra de Navegação Desktop -->
  <nav class="hidden md:block bg-slate-50 dark:bg-[#070b16] border-t border-slate-200 dark:border-blue-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-1 py-1.5">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-4 py-2 text-sm font-bold rounded-lg transition-colors ${
                isActive
                  ? 'bg-blue-600 text-white shadow-sm'
                  : 'text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-slate-200/60 dark:hover:bg-slate-800'
              }`}
            >
              {link.name}
            </a>
          );
        })}

        <a
          href="/produtos?categoria=Portões+e+Grades"
          class="ml-auto inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold text-blue-900 dark:text-blue-200 bg-blue-100/80 dark:bg-blue-950/60 border border-blue-300 dark:border-blue-800 rounded-full hover:bg-blue-200 transition"
        >
          <span>✨</span> Peças em Destaque
        </a>
      </div>
    </div>
  </nav>

  <!-- Menu Mobile Desdobrável -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 dark:border-blue-950 bg-white dark:bg-[#0c1527] px-4 pt-2 pb-4 space-y-1">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          class={`block px-3 py-2 rounded-lg text-base font-medium ${
            isActive
              ? 'bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 font-bold'
              : 'text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white'
          }`}
        >
          {link.name}
        </a>
      );
    })}
    <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex flex-col gap-2">
      <a
        href={`https://wa.me/${loja.whatsapp}?text=${encodeURIComponent('Olá! Gostaria de solicitar um orçamento para peças de serralheria artística.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-3 py-2 text-xs font-bold text-emerald-800 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-300 rounded-lg"
      >
        <span>💬</span> Falar com o Mestre Serralheiro no WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile Menu
  const menuBtn = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Dark Mode Toggle Logic
  const themeToggleBtn = document.getElementById('theme-toggle-btn');
  const sunIcon = document.getElementById('theme-sun-icon');
  const moonIcon = document.getElementById('theme-moon-icon');

  function updateThemeUI() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      sunIcon?.classList.remove('hidden');
      moonIcon?.classList.add('hidden');
    } else {
      sunIcon?.classList.add('hidden');
      moonIcon?.classList.remove('hidden');
    }
  }

  themeToggleBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateThemeUI();
  });

  updateThemeUI();

  // Atualiza badge de orçamento no header
  const cartBadge = document.getElementById('cart-header-badge');
  const cartBtn = document.getElementById('cart-header-btn');

  function updateCartHeaderBadge() {
    try {
      const raw = localStorage.getItem('bompreco_cart_v1');
      const cart = raw ? JSON.parse(raw) : [];
      const totalQtd = cart.reduce((acc: number, item: any) => acc + (item.quantidade || 0), 0);
      if (cartBadge) {
        if (totalQtd > 0) {
          cartBadge.textContent = String(totalQtd);
          cartBadge.classList.remove('hidden');
        } else {
          cartBadge.classList.add('hidden');
        }
      }
    } catch {
      // ignore
    }
  }

  cartBtn?.addEventListener('click', () => {
    if ((window as any).carrinhoMercado) {
      (window as any).carrinhoMercado.abrir();
    }
  });

  window.addEventListener('cart:updated', updateCartHeaderBadge);
  updateCartHeaderBadge();
</script>
